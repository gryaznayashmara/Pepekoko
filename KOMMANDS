@dp.message(F.text == "/start")
async def start(message: Message):

    text = (
        "🎧 <b>Pepe Music Bot</b>\n\n"
        "Команды:\n"
        "/search название\n\n"
        "Пример:\n"
        "/search drake"
    )

    await message.answer(text)


