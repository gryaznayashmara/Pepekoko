@dp.callback_query(F.data.startswith("play:"))
async def play_track(callback: CallbackQuery):

    music_id = int(callback.data.split(":")[1])

    track = db.get_music(music_id)

    if not track:
        await callback.answer("❌ Трек не найден")
        return

    db.increment_plays(music_id)

    await callback.message.answer_audio(
        audio=track["file_id"],
        title=track["title"],
        performer=track["artist"] or "Unknown"
    )

    await callback.answer()
