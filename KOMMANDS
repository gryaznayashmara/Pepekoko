@dp.message(F.text.startswith("/search"))
async def search_music(message: Message):

    query = message.text.replace("/search", "").strip()

    if not query:
        await message.answer(
            "❌ Введи запрос\n\n"
            "Пример:\n"
            "/search eminem"
        )
        return

    results = db.search_music(query)

    if not results:
        await message.answer("😔 Ничего не найдено")
        return

    for track in results:

        text = (
            f"🎵 <b>{track['title']}</b>\n"
            f"👤 {track['artist'] or 'Unknown'}\n"
            f"🔥 Plays: {track['plays']}"
        )

        await message.answer(
            text,
            reply_markup=play_keyboard(track["id"])
        )


